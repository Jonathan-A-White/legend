{
  "description": "Both sides of a 1909-S Lincoln cent, date and mint mark plain: name the cent, the year and the S, with high confidence.",
  "schemaVersion": "1.0",
  "request": { "kind": "coin", "hint": null, "sides": ["obverse", "reverse"] },
