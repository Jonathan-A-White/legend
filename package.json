  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
