  "version": "0.1.49",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "vitest run features/steps",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
