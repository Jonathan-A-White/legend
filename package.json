    "e2e:live": "LEGEND_E2E=live TZ=UTC playwright test --project=live --pass-with-no-tests",
    "icons": "node scripts/make-icons.mjs",
    "data:build": "tsx scripts/data-build.ts",
    "mintages:build": "tsx scripts/mintages-build.ts",
    "check:licence": "tsx scripts/check-licence.ts",
    "grind:build": "tsx scripts/grind-build.ts"
  },
  "dependencies": {
    "@bsv/sdk": "^2.8.11",
    "ajv": "^8.20.0",
    "bsv-kit": "github:Jonathan-A-White/bsv-kit#87b9c427ad851a764a9833928fc057588623ce31",
    "d3-geo": "^3.1.1",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.4.0",
    "pwa-kit": "github:Jonathan-A-White/pwa-kit#7ad2a9dac500c495648291102e9c613e60a3277d",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
