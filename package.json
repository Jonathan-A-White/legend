    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "github:Jonathan-A-White/bsv-kit#87b9c427ad851a764a9833928fc057588623ce31": true,
