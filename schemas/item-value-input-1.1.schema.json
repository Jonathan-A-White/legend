{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "item-value-input-1.1",
  "title": "Item Value Request 1.1",
  "description": "The facts of one coin, banknote or other piece (a token, a medal) and the grade guess made from its photo; no photo, no notes, no tags. `subtype` is what an other piece is, in his words ('Subway token'), and null for a coin or a banknote. `today` is the date the figure is wanted for.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "subtype", "country", "currency", "denomination", "faceValue", "year", "mintMark", "series", "design", "material", "gradeGuess", "gradeNotes", "today"],
  "properties": {
    "kind": { "enum": ["coin", "note", "other"] },
    "subtype": { "type": ["string", "null"], "maxLength": 80 },
    "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "denomination": { "type": "string", "maxLength": 80 },
    "faceValue": { "type": ["number", "null"], "minimum": 0 },
    "year": { "type": ["integer", "null"], "minimum": -1000, "maximum": 2200 },
    "mintMark": { "type": ["string", "null"], "maxLength": 12 },
    "series": { "type": ["string", "null"], "maxLength": 120 },
    "design": { "type": ["string", "null"], "maxLength": 400 },
    "material": { "type": "string", "maxLength": 120 },
    "gradeGuess": { "enum": ["P", "FR", "AG", "G", "VG", "F", "VF", "XF", "AU", "MS", null] },
    "gradeNotes": { "type": "string", "maxLength": 400 },
    "today": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
