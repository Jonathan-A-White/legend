{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coin-from-photos-input-1.1",
  "title": "Coin From Photos input 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "hint", "sides"],
  "properties": {
    "kind": {
      "enum": ["coin", "note", "other", "unknown"]
    },
    "hint": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "sides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": ["obverse", "reverse", "front", "back", "edge", "other"]
      }
    }
  }
}
