{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "legend-ask-input-1.2",
  "title": "Legend Ask input 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "sides", "settings", "history"],
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 400 },
    "sides": {
      "description": "What each attached photo shows, in the photos' order; empty when no photo goes along.",
      "type": "array",
      "maxItems": 2,
      "items": { "enum": ["obverse", "reverse", "other"] }
    },
    "context": {
      "description": "What the screen knows. Missing while he is being helped to fill in a form (`form` is present then).",
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "item", "country", "collectionSummary"],
      "properties": {
        "screen": { "enum": ["item", "country"] },
        "item": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind", "subtype", "country", "countryName", "currency", "denomination", "faceValue", "year", "mintMark", "mintCity", "series",
                "design", "material", "inscription", "gradeGuess", "gradeNotes", "funFact", "confirmed", "rarity", "struck"
              ],
              "properties": {
                "kind": { "enum": ["coin", "note", "other"] },
                "subtype": { "description": "What an other piece is, in his words ('Subway token'); null for a coin or a banknote.", "type": ["string", "null"], "maxLength": 80 },
                "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
                "countryName": { "type": ["string", "null"], "maxLength": 80 },
                "currency": { "type": ["string", "null"], "maxLength": 3 },
                "denomination": { "type": "string", "maxLength": 80 },
                "faceValue": { "type": ["number", "null"] },
                "year": { "type": ["integer", "null"] },
                "mintMark": { "type": ["string", "null"], "maxLength": 8 },
                "mintCity": { "type": ["string", "null"], "maxLength": 60 },
                "series": { "type": ["string", "null"], "maxLength": 200 },
                "design": { "type": ["string", "null"], "maxLength": 400 },
                "material": { "type": "string", "maxLength": 120 },
                "inscription": { "type": "string", "maxLength": 400 },
                "gradeGuess": { "type": ["string", "null"], "maxLength": 8 },
                "gradeNotes": { "type": "string", "maxLength": 400 },
                "funFact": { "type": "string", "maxLength": 400 },
                "confirmed": { "type": "boolean" },
                "rarity": { "description": "The rarity line the app shows for this piece, in its words ('Scarce · 436,800 struck at Denver in 1932 · a key date'), or the mill's own estimate marked as such; null when the app has none.", "type": ["string", "null"], "maxLength": 240 },
                "struck": { "description": "The number struck that the rarity line gives; null when it has none.", "type": ["integer", "null"] }
              }
            }
          ]
        },
        "country": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          ]
        },
        "collectionSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "coins", "notes", "others", "countries"],
          "properties": {
            "items": { "type": "integer", "minimum": 0 },
            "coins": { "type": "integer", "minimum": 0 },
            "notes": { "type": "integer", "minimum": 0 },
            "others": { "type": "integer", "minimum": 0 },
            "countries": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "coins", "notes", "others"],
                "properties": {
                  "code": { "type": "string", "pattern": "^[A-Z]{2}$|^\\?$" },
                  "coins": { "type": "integer", "minimum": 0 },
                  "notes": { "type": "integer", "minimum": 0 },
                  "others": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "form": {
      "description": "Optional. Present while he is being helped to fill in a form of the app (the button 'Let the tutor do it'): the form's name and its fields in screen order, each with the name you answer with, the label he sees, the hint under it if any, whether it is required, its kind, what it holds now ('' when empty; for pictures, how many he has added) and, for a choice, its options; and `command`, the name of the command that sends the form, when the app shows a Send button once every required field holds something. `context` is missing then, `sides` and `settings` are empty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "command": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "required", "kind", "value"],
            "properties": {
              "name": { "description": "The field's key: the name `form_values` and `form_ask` use.", "type": "string", "minLength": 1, "maxLength": 30 },
              "label": { "description": "What the form calls the field on screen.", "type": "string", "minLength": 1, "maxLength": 80 },
              "hint": { "description": "The line under the field, when the form has one.", "type": "string", "minLength": 1, "maxLength": 120 },
              "required": { "description": "Whether the form cannot be sent without it.", "type": "boolean" },
              "kind": { "description": "text: any words; link: a web address; choice: one of `options`, exactly as written; pictures: screenshots or photos, which only he can add (you cannot fill them).", "type": "string", "enum": ["text", "link", "choice", "pictures"] },
              "value": { "description": "What the field holds now, cut at 600 characters; empty when nothing is in it. For pictures, a count such as '2 pictures added'.", "type": "string", "maxLength": 600 },
              "options": { "description": "For a choice: what it can be.", "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
            }
          }
        }
      }
    },
    "settings": {
      "description": "The settings the tutor may suggest a change to, with the value each holds now.",
      "type": "object",
      "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
    },
    "history": {
      "description": "The last questions he asked here and their answers, oldest first.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 400 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 2400 }
        }
      }
    }
  }
}
